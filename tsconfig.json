{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "outDir": "dist"
  },
  "include": ["src", "tests", "scripts", "infra", "next.config.ts", "components"]
}

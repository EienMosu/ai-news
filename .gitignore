# Both forms, deliberately: the trailing slash matches a directory but NOT a symlink,
# and a worktree with a symlinked node_modules slipped one past this rule once.
node_modules
node_modules/
.next/
out/
dist/
cdk.out/
.env*
!.env.example
.DS_Store
*.tsbuildinfo
next-env.d.ts
coverage/

# Design-skill scratch (question logs), not project state
.impeccable/

# Auto-generated by next dev/build (Next 16 agent rules), not project files
/AGENTS.md
/CLAUDE.md

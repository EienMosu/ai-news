        android:pathData="M38,32h22l14,14v30h-36z"
        android:strokeWidth="5"
        android:strokeColor="#191512"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M60,32v14h14"
        android:strokeWidth="5"
        android:strokeColor="#191512"
        android:strokeLineJoin="round" />
</vector>
